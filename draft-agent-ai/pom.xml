<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.draftagent</groupId>
        <artifactId>draft-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>draft-agent-ai</artifactId>
    <name>draft-agent-ai</name>
    <description>预留 Agent 模块 - 后续接入大模型能力</description>

    <dependencies>
        <dependency>
            <groupId>com.draftagent</groupId>
            <artifactId>draft-agent-common</artifactId>
        </dependency>
        <!-- AI 模块单向依赖业务模块：工具通过业务 Service 访问，不直接操作 Mapper -->
        <dependency>
            <groupId>com.draftagent</groupId>
            <artifactId>draft-agent-business</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- JDBC ChatMemory 持久化：版本由父 POM 的 spring-ai-bom(1.0.9) 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>
        <!-- PDF 文档解析（PDFBox）：版本由父 POM 的 spring-ai-bom(1.0.9) 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>
        <!-- 官方 Qdrant Java Client（gRPC）：版本与 Spring AI 1.0.9 的 qdrant-store 保持一致 -->
        <dependency>
            <groupId>io.qdrant</groupId>
            <artifactId>client</artifactId>
        </dependency>
        <!-- 生成的 protobuf 类需要编译期 protobuf-java（与 gRPC 传递版本一致） -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <!-- Qdrant Client 公共 API 返回 ListenableFuture / 引用 ManagedChannel，需编译期依赖 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
    </dependencies>
</project>
